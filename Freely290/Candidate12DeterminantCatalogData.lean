module

public import Freely290.Candidate12UpgradeTargets

@[expose] public section
namespace Freely290

set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

def candidate12DeterminantCross (i : Fin 197) (j : Fin 3) : ℤ :=
  ((( : ℕ) >>> (15*i.val+5*j.val))%32 : ℕ) - (10 : ℤ)

def candidate12DeterminantValue (i : Fin 197) : ℕ :=
  (( : ℕ) >>> (10*i.val))%1024

def candidate12DeterminantIndex (d : ℕ) : Fin 197 :=
  ⟨((( : ℕ) >>> (8*d))%256)%197,Nat.mod_lt _ (by decide)⟩

def candidate12DeterminantNumeric (c : Candidate12UpgradeCode) : Prop :=
  let d := candidate12UpgradeDelta c
  d≠0 ∧ (0<d → (candidate12DeterminantValue (candidate12DeterminantIndex d.toNat) : ℤ)=d)

instance (c : Candidate12UpgradeCode) : Decidable (candidate12DeterminantNumeric c) := by
  unfold candidate12DeterminantNumeric
  infer_instance

def Candidate12DeterminantConclusion {M : Type*} [AddCommGroup M] (Q : QuadraticForm ℤ M) (i : Fin 197) : Prop :=
  ∀ f : (Fin 4 → ℤ) →ₗ[ℤ] M, Q.comp f=(candidate12KnownRegularMatrix (candidate12DeterminantCross i)).toQuadraticForm' → Universal Q

end Freely290
