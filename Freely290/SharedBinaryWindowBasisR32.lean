module

public import Freely290.SharedBinaryInitialWindow

@[expose] public section
namespace Freely290

set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

def sharedBinaryWindowBasisR32Row0 : Fin 4 → ℕ := ![,,,]

def sharedBinaryWindowBasisR32Row1 : Fin 4 → ℕ := ![,,,]

def sharedBinaryWindowBasisR32Words : Fin 2 → Fin 4 → ℕ := ![sharedBinaryWindowBasisR32Row0,sharedBinaryWindowBasisR32Row1]

private theorem sharedBinaryWindowBasisR32Left0 :
    finiteShiftMask (fun x : ℤ ↦ x^2+0*x) (fun _ ↦ 1) (binaryShiftMaskRange 32) = 0x10000000000000002000000000000001000000000000002000000000000010000000000000200000000000010000000000002000000000001000000000002000000000010000000000200000000010000000002000000001000000002000000010000000200000010000002000001000002000010000200010002001002010213 := by decide +kernel

theorem sharedBinaryWindowBasisR32Word00 :
    sharedBinaryWindowBasisR32Words 0 0 = binaryShiftMask 32 0 (-1) := by
  change sharedBinaryWindowBasisR32Words 0 0 =
    finiteShiftMask (fun y : ℤ ↦ 2*y^2+(-1:ℤ)*y)
      (fun _ : ℤ ↦ finiteShiftMask (fun x : ℤ ↦ x^2+(0:ℤ)*x)
        (fun _ : ℤ ↦ (1:ℕ)) (binaryShiftMaskRange 32)) (binaryShiftMaskRange 32)
  rw [sharedBinaryWindowBasisR32Left0]
  decide +kernel

theorem sharedBinaryWindowBasisR32Word01 :
    sharedBinaryWindowBasisR32Words 0 1 = binaryShiftMask 32 0 (0) := by
  change sharedBinaryWindowBasisR32Words 0 1 =
    finiteShiftMask (fun y : ℤ ↦ 2*y^2+(0:ℤ)*y)
      (fun _ : ℤ ↦ finiteShiftMask (fun x : ℤ ↦ x^2+(0:ℤ)*x)
        (fun _ : ℤ ↦ (1:ℕ)) (binaryShiftMaskRange 32)) (binaryShiftMaskRange 32)
  rw [sharedBinaryWindowBasisR32Left0]
  decide +kernel

theorem sharedBinaryWindowBasisR32Word02 :
    sharedBinaryWindowBasisR32Words 0 2 = binaryShiftMask 32 0 (1) := by
  change sharedBinaryWindowBasisR32Words 0 2 =
    finiteShiftMask (fun y : ℤ ↦ 2*y^2+(1:ℤ)*y)
      (fun _ : ℤ ↦ finiteShiftMask (fun x : ℤ ↦ x^2+(0:ℤ)*x)
        (fun _ : ℤ ↦ (1:ℕ)) (binaryShiftMaskRange 32)) (binaryShiftMaskRange 32)
  rw [sharedBinaryWindowBasisR32Left0]
  decide +kernel

theorem sharedBinaryWindowBasisR32Word03 :
    sharedBinaryWindowBasisR32Words 0 3 = binaryShiftMask 32 0 (2) := by
  change sharedBinaryWindowBasisR32Words 0 3 =
    finiteShiftMask (fun y : ℤ ↦ 2*y^2+(2:ℤ)*y)
      (fun _ : ℤ ↦ finiteShiftMask (fun x : ℤ ↦ x^2+(0:ℤ)*x)
        (fun _ : ℤ ↦ (1:ℕ)) (binaryShiftMaskRange 32)) (binaryShiftMaskRange 32)
  rw [sharedBinaryWindowBasisR32Left0]
  decide +kernel

private theorem sharedBinaryWindowBasisR32Left1 :
    finiteShiftMask (fun x : ℤ ↦ x^2+1*x) (fun _ ↦ 1) (binaryShiftMaskRange 32) = 0x1000000000000000100000000000000040000000000000040000000000000100000000000001000000000000040000000000004000000000001000000000001000000000004000000000040000000001000000000100000000040000000040000000100000001000000040000004000001000001000004000040001000100040040101045 := by decide +kernel

theorem sharedBinaryWindowBasisR32Word10 :
    sharedBinaryWindowBasisR32Words 1 0 = binaryShiftMask 32 1 (-1) := by
  change sharedBinaryWindowBasisR32Words 1 0 =
    finiteShiftMask (fun y : ℤ ↦ 2*y^2+(-1:ℤ)*y)
      (fun _ : ℤ ↦ finiteShiftMask (fun x : ℤ ↦ x^2+(1:ℤ)*x)
        (fun _ : ℤ ↦ (1:ℕ)) (binaryShiftMaskRange 32)) (binaryShiftMaskRange 32)
  rw [sharedBinaryWindowBasisR32Left1]
  decide +kernel

theorem sharedBinaryWindowBasisR32Word11 :
    sharedBinaryWindowBasisR32Words 1 1 = binaryShiftMask 32 1 (0) := by
  change sharedBinaryWindowBasisR32Words 1 1 =
    finiteShiftMask (fun y : ℤ ↦ 2*y^2+(0:ℤ)*y)
      (fun _ : ℤ ↦ finiteShiftMask (fun x : ℤ ↦ x^2+(1:ℤ)*x)
        (fun _ : ℤ ↦ (1:ℕ)) (binaryShiftMaskRange 32)) (binaryShiftMaskRange 32)
  rw [sharedBinaryWindowBasisR32Left1]
  decide +kernel

theorem sharedBinaryWindowBasisR32Word12 :
    sharedBinaryWindowBasisR32Words 1 2 = binaryShiftMask 32 1 (1) := by
  change sharedBinaryWindowBasisR32Words 1 2 =
    finiteShiftMask (fun y : ℤ ↦ 2*y^2+(1:ℤ)*y)
      (fun _ : ℤ ↦ finiteShiftMask (fun x : ℤ ↦ x^2+(1:ℤ)*x)
        (fun _ : ℤ ↦ (1:ℕ)) (binaryShiftMaskRange 32)) (binaryShiftMaskRange 32)
  rw [sharedBinaryWindowBasisR32Left1]
  decide +kernel

theorem sharedBinaryWindowBasisR32Word13 :
    sharedBinaryWindowBasisR32Words 1 3 = binaryShiftMask 32 1 (2) := by
  change sharedBinaryWindowBasisR32Words 1 3 =
    finiteShiftMask (fun y : ℤ ↦ 2*y^2+(2:ℤ)*y)
      (fun _ : ℤ ↦ finiteShiftMask (fun x : ℤ ↦ x^2+(1:ℤ)*x)
        (fun _ : ℤ ↦ (1:ℕ)) (binaryShiftMaskRange 32)) (binaryShiftMaskRange 32)
  rw [sharedBinaryWindowBasisR32Left1]
  decide +kernel

def sharedBinaryWindowBasisR32 : BinaryWindowBasis := BinaryWindowBasis.ofExact 32 sharedBinaryWindowBasisR32Words (by
  intro a b
  fin_cases a <;> fin_cases b
  · exact sharedBinaryWindowBasisR32Word00
  · exact sharedBinaryWindowBasisR32Word01
  · exact sharedBinaryWindowBasisR32Word02
  · exact sharedBinaryWindowBasisR32Word03
  · exact sharedBinaryWindowBasisR32Word10
  · exact sharedBinaryWindowBasisR32Word11
  · exact sharedBinaryWindowBasisR32Word12
  · exact sharedBinaryWindowBasisR32Word13
)

end Freely290
