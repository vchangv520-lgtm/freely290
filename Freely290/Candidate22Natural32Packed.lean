private theorem candidate22Natural32PackedChecks : ∀ j, (candidate22Natural32PackedBatches j).check candidate22Natural32PackedCoeff candidate22Natural32PackedStep=true := by
  intro j
  fin_cases j
  · exact candidate22Natural32PackedB000_checked

private def candidate22Natural32PackedRow (r : Fin 588) : Prop :=
  BitPlane.rangeCheck 1 588 (candidate22Natural32PackedTail.cost r) r.val (candidate22Natural32PackedStart r)
    (candidate22Natural32PackedBatches (candidate22Natural32PackedWhich r)).edges (candidate22Natural32PackedBatches (candidate22Natural32PackedWhich r)).target=true ∨ ¬Squarefree (Nat.gcd r.val 588)

private instance (r : Fin 588) : Decidable (candidate22Natural32PackedRow r) := by unfold candidate22Natural32PackedRow; infer_instance

private theorem candidate22Natural32PackedRows000 : ∀ t : Fin 128, ∀ h : 0+t.val<588, candidate22Natural32PackedRow ⟨0+t.val,h⟩ := by decide +kernel

private theorem candidate22Natural32PackedRows001 : ∀ t : Fin 128, ∀ h : 128+t.val<588, candidate22Natural32PackedRow ⟨128+t.val,h⟩ := by decide +kernel

private theorem candidate22Natural32PackedRows002 : ∀ t : Fin 128, ∀ h : 256+t.val<588, candidate22Natural32PackedRow ⟨256+t.val,h⟩ := by decide +kernel

private theorem candidate22Natural32PackedRows003 : ∀ t : Fin 128, ∀ h : 384+t.val<588, candidate22Natural32PackedRow ⟨384+t.val,h⟩ := by decide +kernel

private theorem candidate22Natural32PackedRows004 : ∀ t : Fin 128, ∀ h : 512+t.val<588, candidate22Natural32PackedRow ⟨512+t.val,h⟩ := by decide +kernel

private theorem candidate22Natural32PackedCover (r : Fin 588) : candidate22Natural32PackedRow r := by
  let b : Fin 5 := ⟨r.val/128,by omega⟩
  let t : Fin 128 := ⟨r.val%128,Nat.mod_lt _ (by decide)⟩
  have he : 128*b.val+t.val=r.val := by dsimp [b,t];omega
  have allRows : ∀ k : Fin 5, ∀ t : Fin 128, ∀ h : 128*k.val+t.val<588, candidate22Natural32PackedRow ⟨128*k.val+t.val,h⟩ := by
    intro k
    fin_cases k
    · exact candidate22Natural32PackedRows000
    · exact candidate22Natural32PackedRows001
    · exact candidate22Natural32PackedRows002
    · exact candidate22Natural32PackedRows003
    · exact candidate22Natural32PackedRows004
  have good := allRows b t (by rw [he]; exact r.isLt)
  simpa only [he] using good

theorem candidate22Natural32Packed_universal_of_comp {M : Type*} [AddCommGroup M] {Q : QuadraticForm ℤ M}
    (hc : Checks Q critical) (f : (Fin 4 → ℤ) →ₗ[ℤ] M)
    (hf : Q.comp f=candidate22Natural32Matrix.toQuadraticForm') : Universal Q := by
  apply candidate22Natural32PackedTail.universal_of_bitplane_sf_rows_comp candidate22Natural32PackedCoeff (by decide +kernel) candidate22Natural32PackedBatches candidate22Natural32PackedStep
    (by decide) candidate22Natural32PackedChecks candidate22Natural32PackedWhich candidate22Natural32PackedStart candidate22Natural32PackedCover _ hc f hf
  have noEx : ∀ j, (candidate22Natural32PackedBatches j).exceptions=[] := by decide +kernel
  intro j e he
  rw [noEx j] at he
  contradiction

