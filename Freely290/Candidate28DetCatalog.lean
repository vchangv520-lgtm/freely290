module

public import Freely290.Candidate28FullUpgradeTargets
public import Freely290.Candidate28SplitDiscriminant

@[expose] public section
namespace Freely290

set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace Candidate28DetCatalog

def index (delta : ℕ) : Fin 259 :=
  ⟨((( : ℕ) >>> (9*delta))%512)%259,Nat.mod_lt _ (by decide)⟩

private def value (i : Fin 259) : ℕ :=
  (( : ℕ) >>> (11*i.val))%2048

private def numeric (c : Candidate28FullUpgradeCode) : Prop :=
  let d := candidate28FullUpgradeDelta c
  0≤d → (value (index d.toNat):ℤ)=d

private instance (c : Candidate28FullUpgradeCode) : Decidable (numeric c) := by unfold numeric; infer_instance

private theorem target_norm (i : Fin 259) :
    1520-Candidate28SplitDiscriminant.candidate28SplitDiscriminantNorm (candidate28FullUpgradeQuadTargetCross i)=(value i:ℤ) := by
  revert i
  decide +kernel

private theorem numeric00 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (0,b,z) := by decide +kernel

private theorem numeric01 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (1,b,z) := by decide +kernel

private theorem numeric02 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (2,b,z) := by decide +kernel

private theorem numeric03 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (3,b,z) := by decide +kernel

private theorem numeric04 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (4,b,z) := by decide +kernel

private theorem numeric05 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (5,b,z) := by decide +kernel

private theorem numeric06 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (6,b,z) := by decide +kernel

private theorem numeric07 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (7,b,z) := by decide +kernel

private theorem numeric08 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (8,b,z) := by decide +kernel

private theorem numeric09 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (9,b,z) := by decide +kernel

private theorem numeric10 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (10,b,z) := by decide +kernel

private theorem numeric11 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (11,b,z) := by decide +kernel

private theorem numeric12 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (12,b,z) := by decide +kernel

private theorem checked (c : Candidate28FullUpgradeCode) : numeric c := by
  rcases c with ⟨a,b,z⟩
  fin_cases a
  · exact numeric00 b z
  · exact numeric01 b z
  · exact numeric02 b z
  · exact numeric03 b z
  · exact numeric04 b z
  · exact numeric05 b z
  · exact numeric06 b z
  · exact numeric07 b z
  · exact numeric08 b z
  · exact numeric09 b z
  · exact numeric10 b z
  · exact numeric11 b z
  · exact numeric12 b z

private theorem source_norm (c : Candidate28FullUpgradeCode) :
    1520-Candidate28SplitDiscriminant.candidate28SplitDiscriminantNorm (candidate28FullUpgradeA c)=candidate28FullUpgradeDelta c := by
  simp [Candidate28SplitDiscriminant.candidate28SplitDiscriminantNorm,candidate28FullUpgradeDelta,candidate28FullUpgradeAdjugateCross]
  ring

theorem classify (c : Candidate28FullUpgradeCode) (hc : Candidate28FullUpgradeValid c) :
    ∃ (i : Fin 259) (f : (Fin 4 → ℤ) →ₗ[ℤ] (Fin 4 → ℤ)),
      (candidate28FullUpgradeMatrix c).toQuadraticForm'.comp f=(candidate28FullUpgradeQuadTarget i).toQuadraticForm' := by
  let i := index (candidate28FullUpgradeDelta c).toNat
  have h₁ : (value i:ℤ)=candidate28FullUpgradeDelta c := checked c hc
  have h₂ := target_norm i
  have h₃ := source_norm c
  have hn : Candidate28SplitDiscriminant.candidate28SplitDiscriminantNorm (candidate28FullUpgradeA c)=Candidate28SplitDiscriminant.candidate28SplitDiscriminantNorm (candidate28FullUpgradeQuadTargetCross i) := by omega
  obtain ⟨f,hf⟩ := Candidate28SplitDiscriminant.embed 10 (candidate28FullUpgradeA c) (candidate28FullUpgradeQuadTargetCross i) hn
  exact ⟨i,f,hf⟩

end Candidate28DetCatalog

end Freely290
