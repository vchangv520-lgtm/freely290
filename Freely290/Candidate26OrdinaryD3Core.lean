def candidate26OrdinaryD3Line (r : SplitPrimeChart 17) : Fin 18 :=
  match r with
  | .inl (y,z) => match y.val with
    | 0 => if z.val = 5 then 0 else if z.val = 12 then 1 else 0
    | 1 => if z.val = 4 then 2 else if z.val = 13 then 3 else 0
    | 4 => if z.val = 0 then 4 else 0
    | 5 => if z.val = 2 then 5 else if z.val = 15 then 6 else 0
    | 7 => if z.val = 3 then 7 else if z.val = 14 then 8 else 0
    | 10 => if z.val = 3 then 9 else if z.val = 14 then 10 else 0
    | 12 => if z.val = 2 then 11 else if z.val = 15 then 12 else 0
    | 13 => if z.val = 0 then 13 else 0
    | 16 => if z.val = 4 then 14 else if z.val = 13 then 15 else 0
    | _ => 0
  | .inr (.inl z) => if z.val = 5 then 16 else if z.val = 12 then 17 else 0
  | .inr (.inr _) => 0

theorem candidate26OrdinaryD3Matrices : ∀ l j, scaledMatrixTransferCheck
    ((17 : ℤ) • candidate26FullSeedMatrix) splitPrimeOrdinaryMatrix (candidate26OrdinaryD3Frames l j) 51 = true := by
  decide +kernel

theorem candidate26OrdinaryD3Isotropic : ∀ r, (17 : ℤ) ∣ splitPrimeNorm (splitPrimeChartVector r) →
    ∀ j, residueDivisibilityCheck (candidate26OrdinaryD3Frames (candidate26OrdinaryD3Line r) j) 17 (splitPrimeChartVector r) = true := by
  decide +kernel

