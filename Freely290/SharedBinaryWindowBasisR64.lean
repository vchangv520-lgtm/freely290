module

public import Freely290.SharedBinaryInitialWindow
public import Freely290.PackedWordLiteral

@[expose] public section
namespace Freely290

set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

def sharedBinaryWindowBasisR64Row0 : Fin 4 → ℕ := ![(packedWordAppend 6176 (packedWordAppend 3088  ) (packedWordAppend 3088  )),(packedWordAppend 6144 (packedWordAppend 3072  ) (packedWordAppend 3072  )),(packedWordAppend 6176 (packedWordAppend 3088  ) (packedWordAppend 3088  )),(packedWordAppend 6208 (packedWordAppend 3104  ) (packedWordAppend 3104  ))]

def sharedBinaryWindowBasisR64Row1 : Fin 4 → ℕ := ![(packedWordAppend 6208 (packedWordAppend 3104  ) (packedWordAppend 3104  )),(packedWordAppend 6176 (packedWordAppend 3088  ) (packedWordAppend 3088  )),(packedWordAppend 6208 (packedWordAppend 3104  ) (packedWordAppend 3104  )),(packedWordAppend 6240 (packedWordAppend 3120  ) (packedWordAppend 3120  ))]

def sharedBinaryWindowBasisR64Words : Fin 2 → Fin 4 → ℕ := ![sharedBinaryWindowBasisR64Row0,sharedBinaryWindowBasisR64Row1]

private theorem sharedBinaryWindowBasisR64Left0 :
    finiteShiftMask (fun x : ℤ ↦ x^2+0*x) (fun _ ↦ 1) (binaryShiftMaskRange 64) = (packedWordAppend 2048  ) := by decide +kernel

theorem sharedBinaryWindowBasisR64Word00 :
    sharedBinaryWindowBasisR64Words 0 0 = binaryShiftMask 64 0 (-1) := by
  change sharedBinaryWindowBasisR64Words 0 0 =
    finiteShiftMask (fun y : ℤ ↦ 2*y^2+(-1:ℤ)*y)
      (fun _ : ℤ ↦ finiteShiftMask (fun x : ℤ ↦ x^2+(0:ℤ)*x)
        (fun _ : ℤ ↦ (1:ℕ)) (binaryShiftMaskRange 64)) (binaryShiftMaskRange 64)
  rw [sharedBinaryWindowBasisR64Left0]
  decide +kernel

theorem sharedBinaryWindowBasisR64Word01 :
    sharedBinaryWindowBasisR64Words 0 1 = binaryShiftMask 64 0 (0) := by
  change sharedBinaryWindowBasisR64Words 0 1 =
    finiteShiftMask (fun y : ℤ ↦ 2*y^2+(0:ℤ)*y)
      (fun _ : ℤ ↦ finiteShiftMask (fun x : ℤ ↦ x^2+(0:ℤ)*x)
        (fun _ : ℤ ↦ (1:ℕ)) (binaryShiftMaskRange 64)) (binaryShiftMaskRange 64)
  rw [sharedBinaryWindowBasisR64Left0]
  decide +kernel

theorem sharedBinaryWindowBasisR64Word02 :
    sharedBinaryWindowBasisR64Words 0 2 = binaryShiftMask 64 0 (1) := by
  change sharedBinaryWindowBasisR64Words 0 2 =
    finiteShiftMask (fun y : ℤ ↦ 2*y^2+(1:ℤ)*y)
      (fun _ : ℤ ↦ finiteShiftMask (fun x : ℤ ↦ x^2+(0:ℤ)*x)
        (fun _ : ℤ ↦ (1:ℕ)) (binaryShiftMaskRange 64)) (binaryShiftMaskRange 64)
  rw [sharedBinaryWindowBasisR64Left0]
  decide +kernel

theorem sharedBinaryWindowBasisR64Word03 :
    sharedBinaryWindowBasisR64Words 0 3 = binaryShiftMask 64 0 (2) := by
  change sharedBinaryWindowBasisR64Words 0 3 =
    finiteShiftMask (fun y : ℤ ↦ 2*y^2+(2:ℤ)*y)
      (fun _ : ℤ ↦ finiteShiftMask (fun x : ℤ ↦ x^2+(0:ℤ)*x)
        (fun _ : ℤ ↦ (1:ℕ)) (binaryShiftMaskRange 64)) (binaryShiftMaskRange 64)
  rw [sharedBinaryWindowBasisR64Left0]
  decide +kernel

private theorem sharedBinaryWindowBasisR64Left1 :
    finiteShiftMask (fun x : ℤ ↦ x^2+1*x) (fun _ ↦ 1) (binaryShiftMaskRange 64) = (packedWordAppend 2080  ) := by decide +kernel

theorem sharedBinaryWindowBasisR64Word10 :
    sharedBinaryWindowBasisR64Words 1 0 = binaryShiftMask 64 1 (-1) := by
  change sharedBinaryWindowBasisR64Words 1 0 =
    finiteShiftMask (fun y : ℤ ↦ 2*y^2+(-1:ℤ)*y)
      (fun _ : ℤ ↦ finiteShiftMask (fun x : ℤ ↦ x^2+(1:ℤ)*x)
        (fun _ : ℤ ↦ (1:ℕ)) (binaryShiftMaskRange 64)) (binaryShiftMaskRange 64)
  rw [sharedBinaryWindowBasisR64Left1]
  decide +kernel

theorem sharedBinaryWindowBasisR64Word11 :
    sharedBinaryWindowBasisR64Words 1 1 = binaryShiftMask 64 1 (0) := by
  change sharedBinaryWindowBasisR64Words 1 1 =
    finiteShiftMask (fun y : ℤ ↦ 2*y^2+(0:ℤ)*y)
      (fun _ : ℤ ↦ finiteShiftMask (fun x : ℤ ↦ x^2+(1:ℤ)*x)
        (fun _ : ℤ ↦ (1:ℕ)) (binaryShiftMaskRange 64)) (binaryShiftMaskRange 64)
  rw [sharedBinaryWindowBasisR64Left1]
  decide +kernel

theorem sharedBinaryWindowBasisR64Word12 :
    sharedBinaryWindowBasisR64Words 1 2 = binaryShiftMask 64 1 (1) := by
  change sharedBinaryWindowBasisR64Words 1 2 =
    finiteShiftMask (fun y : ℤ ↦ 2*y^2+(1:ℤ)*y)
      (fun _ : ℤ ↦ finiteShiftMask (fun x : ℤ ↦ x^2+(1:ℤ)*x)
        (fun _ : ℤ ↦ (1:ℕ)) (binaryShiftMaskRange 64)) (binaryShiftMaskRange 64)
  rw [sharedBinaryWindowBasisR64Left1]
  decide +kernel

theorem sharedBinaryWindowBasisR64Word13 :
    sharedBinaryWindowBasisR64Words 1 3 = binaryShiftMask 64 1 (2) := by
  change sharedBinaryWindowBasisR64Words 1 3 =
    finiteShiftMask (fun y : ℤ ↦ 2*y^2+(2:ℤ)*y)
      (fun _ : ℤ ↦ finiteShiftMask (fun x : ℤ ↦ x^2+(1:ℤ)*x)
        (fun _ : ℤ ↦ (1:ℕ)) (binaryShiftMaskRange 64)) (binaryShiftMaskRange 64)
  rw [sharedBinaryWindowBasisR64Left1]
  decide +kernel

def sharedBinaryWindowBasisR64 : BinaryWindowBasis := BinaryWindowBasis.ofExact 64 sharedBinaryWindowBasisR64Words (by
  intro a b
  fin_cases a <;> fin_cases b
  · exact sharedBinaryWindowBasisR64Word00
  · exact sharedBinaryWindowBasisR64Word01
  · exact sharedBinaryWindowBasisR64Word02
  · exact sharedBinaryWindowBasisR64Word03
  · exact sharedBinaryWindowBasisR64Word10
  · exact sharedBinaryWindowBasisR64Word11
  · exact sharedBinaryWindowBasisR64Word12
  · exact sharedBinaryWindowBasisR64Word13
)

end Freely290
