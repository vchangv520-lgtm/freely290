theorem candidate25DiscriminantTarget_exists (c : Candidate25FullUpgradeCode) (hv : Candidate25FullUpgradeValid c) :
    ∃ i : Fin 848, candidate25DiscriminantShearNorm (candidate25FullUpgradeA c) = candidate25DiscriminantShearNorm (candidate25FullUpgradeQuadTargetCross i) := by
  have hb (b : Fin 36) : candidate25DiscriminantBlocks b.val = discriminantMaskRange (fun k ↦ 2^(candidate25DiscriminantTargetKey k)) 24 (24*b.val) := by
    fin_cases b
    · exact candidate25DiscriminantBlock00
    · exact candidate25DiscriminantBlock01
    · exact candidate25DiscriminantBlock02
    · exact candidate25DiscriminantBlock03
    · exact candidate25DiscriminantBlock04
    · exact candidate25DiscriminantBlock05
    · exact candidate25DiscriminantBlock06
    · exact candidate25DiscriminantBlock07
    · exact candidate25DiscriminantBlock08
    · exact candidate25DiscriminantBlock09
    · exact candidate25DiscriminantBlock10
    · exact candidate25DiscriminantBlock11
    · exact candidate25DiscriminantBlock12
    · exact candidate25DiscriminantBlock13
    · exact candidate25DiscriminantBlock14
    · exact candidate25DiscriminantBlock15
    · exact candidate25DiscriminantBlock16
    · exact candidate25DiscriminantBlock17
    · exact candidate25DiscriminantBlock18
    · exact candidate25DiscriminantBlock19
    · exact candidate25DiscriminantBlock20
    · exact candidate25DiscriminantBlock21
    · exact candidate25DiscriminantBlock22
    · exact candidate25DiscriminantBlock23
    · exact candidate25DiscriminantBlock24
    · exact candidate25DiscriminantBlock25
    · exact candidate25DiscriminantBlock26
    · exact candidate25DiscriminantBlock27
    · exact candidate25DiscriminantBlock28
    · exact candidate25DiscriminantBlock29
    · exact candidate25DiscriminantBlock30
    · exact candidate25DiscriminantBlock31
    · exact candidate25DiscriminantBlock32
    · exact candidate25DiscriminantBlock33
    · exact candidate25DiscriminantBlock34
    · exact candidate25DiscriminantBlock35
  obtain ⟨i,he⟩ := discriminantMask_targets candidate25DiscriminantTargetKey candidate25DiscriminantBlocks 36 24 candidate25DiscriminantMask
    candidate25DiscriminantAllBlocks hb (candidate25DiscriminantMask_of_valid c hv)
  refine ⟨candidate25DiscriminantIndex i,?_⟩
  unfold candidate25DiscriminantTargetKey at he
  have h₁ := candidate25DiscriminantNorm_nonneg (candidate25FullUpgradeQuadTargetCross (candidate25DiscriminantIndex i))
  have h₂ := candidate25DiscriminantNorm_nonneg (candidate25FullUpgradeA c)
  omega

