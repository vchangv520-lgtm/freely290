private def candidate23DiscriminantIndex (k : ℕ) : Fin 963 := ⟨k%963, Nat.mod_lt _ (by decide)⟩
private def candidate23DiscriminantTargetKey (k : ℕ) :=
  (2*candidate23DiscriminantShearNorm (candidate23FullUpgradeQuadTargetCross (candidate23DiscriminantIndex k))).toNat

