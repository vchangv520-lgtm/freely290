theorem candidate23DiscriminantTarget_exists (c : Candidate23FullUpgradeCode) (hv : Candidate23FullUpgradeValid c) :
    ∃ i : Fin 963, candidate23DiscriminantShearNorm (candidate23FullUpgradeA c) = candidate23DiscriminantShearNorm (candidate23FullUpgradeQuadTargetCross i) := by
  have hb (b : Fin 41) : candidate23DiscriminantBlocks b.val = discriminantMaskRange (fun k ↦ 2^(candidate23DiscriminantTargetKey k)) 24 (24*b.val) := by
    fin_cases b
    · exact candidate23DiscriminantBlock00
    · exact candidate23DiscriminantBlock01
    · exact candidate23DiscriminantBlock02
    · exact candidate23DiscriminantBlock03
    · exact candidate23DiscriminantBlock04
    · exact candidate23DiscriminantBlock05
    · exact candidate23DiscriminantBlock06
    · exact candidate23DiscriminantBlock07
