    · exact candidate23DiscriminantBlock35
    · exact candidate23DiscriminantBlock36
    · exact candidate23DiscriminantBlock37
    · exact candidate23DiscriminantBlock38
    · exact candidate23DiscriminantBlock39
    · exact candidate23DiscriminantBlock40
  obtain ⟨i,he⟩ := discriminantMask_targets candidate23DiscriminantTargetKey candidate23DiscriminantBlocks 41 24 candidate23DiscriminantMask
    candidate23DiscriminantAllBlocks hb (candidate23DiscriminantMask_of_valid c hv)
  refine ⟨candidate23DiscriminantIndex i,?_⟩
  unfold candidate23DiscriminantTargetKey at he
  have h₁ := candidate23DiscriminantNorm_nonneg (candidate23FullUpgradeQuadTargetCross (candidate23DiscriminantIndex i))
  have h₂ := candidate23DiscriminantNorm_nonneg (candidate23FullUpgradeA c)
  omega

