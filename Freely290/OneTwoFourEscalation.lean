/-- This assertion excludes only thirty, and concerns positive squarefree values. -/
theorem oneTwoFourUpgrade_represents_squarefree_of_ne_thirty
    (c : OneTwoFourUpgradeCode) (hc : OneTwoFourUpgradeValid c) {n : ℕ}
    (hn : 0 < n) (hs : Squarefree n) (hne : n ≠ 30) :
    Represents (oneTwoFourUpgradeForm c) n := by
  have h := oneTwoFourUpgradeLookup_checked c.1 c.2.1 c.2.2 hc
  exact (matrixChangeOfBasisCheck_represents_iff h n).mpr
    (oneTwoFourUpgradeRepresentative_represents_squarefree_of_ne_thirty
      (oneTwoFourUpgradeLookup c.1 c.2.1 c.2.2).1 hn hs hne)

theorem oneTwoFourUpgrade_universal_of_thirty (c : OneTwoFourUpgradeCode)
    (hc : OneTwoFourUpgradeValid c) (h30 : Represents (oneTwoFourUpgradeForm c) 30) :
    Universal (oneTwoFourUpgradeForm c) := by
  apply universal_iff_squarefree_representation.mpr
  intro n hn hs
  by_cases h : n = 30
  · simpa only [h] using h30
  · exact oneTwoFourUpgrade_represents_squarefree_of_ne_thirty c hc hn hs h

variable {M : Type*} [AddCommGroup M]

/-- The ambient representation of thirty supplies the only possible missing value. -/
theorem oneTwoFourUpgrade_universal_of_comp_and_thirty {Q : QuadraticForm ℤ M}
    (c : OneTwoFourUpgradeCode) (hc : OneTwoFourUpgradeValid c)
    (f : (Fin 4 → ℤ) →ₗ[ℤ] M) (hf : Q.comp f = oneTwoFourUpgradeForm c)
    (h30 : Represents Q 30) : Universal Q := by
  apply universal_iff_squarefree_representation.mpr
  intro n hn hs
  by_cases h : n = 30
  · simpa only [h] using h30
  · apply represents_of_comp f
    rw [hf]
    exact oneTwoFourUpgrade_represents_squarefree_of_ne_thirty c hc hn hs h

