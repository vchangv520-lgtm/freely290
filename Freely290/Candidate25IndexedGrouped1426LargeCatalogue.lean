def candidate25IndexedGrouped1426LargeValid (v : IndexedPeriodicCosetWindow Candidate25FullUpgradeCode 848) : Prop :=
  candidate25FullUpgradeDelta v.code = (v.discr : ℤ) ∧
  (∀ r : Fin 713, Candidate25BundledGrouped1426CosetGood r.val (v.discr*(candidate25IndexedGrouped1426LargeShift0 v r)^2)) ∧
  (∀ r : Fin 713, (v.discr*(candidate25IndexedGrouped1426LargeShift0 v r)^2+28)/29 ≤ v.bound) ∧
