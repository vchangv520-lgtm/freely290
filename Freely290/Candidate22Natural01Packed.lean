private theorem candidate22Natural01PackedCover (r : Fin 588) : candidate22Natural01PackedRow r := by
  let b : Fin 5 := ⟨r.val/128,by omega⟩
  let t : Fin 128 := ⟨r.val%128,Nat.mod_lt _ (by decide)⟩
  have he : 128*b.val+t.val=r.val := by dsimp [b,t];omega
  have allRows : ∀ k : Fin 5, ∀ t : Fin 128, ∀ h : 128*k.val+t.val<588, candidate22Natural01PackedRow ⟨128*k.val+t.val,h⟩ := by
    intro k
    fin_cases k
    · exact candidate22Natural01PackedRows000
    · exact candidate22Natural01PackedRows001
    · exact candidate22Natural01PackedRows002
    · exact candidate22Natural01PackedRows003
    · exact candidate22Natural01PackedRows004
  have good := allRows b t (by rw [he]; exact r.isLt)
  simpa only [he] using good

