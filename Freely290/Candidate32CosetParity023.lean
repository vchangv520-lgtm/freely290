private theorem candidate32CosetParity023Witness_checked (r : Fin 563) (h : r.val%2=1) :
    matrixValue (oneTwoFiveNeighborThirtyTwoUpgradeMatrix candidate32CosetParity023Code) (candidate32CosetParity023Witness r.val) = (r.val : ℤ) := by
  let b : Fin 18 := ⟨r.val/32, by omega⟩
  let j : Fin 32 := ⟨r.val%32, by omega⟩
  have he : 32*b.val+j.val = r.val := by dsimp [b,j]; omega
  have hc : ∀ t : Fin 18, ∀ u : Fin 32, 32*t.val+u.val<563 → (32*t.val+u.val)%2=1 →
      matrixValue (oneTwoFiveNeighborThirtyTwoUpgradeMatrix candidate32CosetParity023Code) (candidate32CosetParity023Witness (32*t.val+u.val)) =
        ((32*t.val+u.val : ℕ) : ℤ) := by
    intro t
    fin_cases t <;> decide +kernel
  have hl : 32*b.val+j.val < 563 := by rw [he]; exact r.isLt
  have hh : (32*b.val+j.val)%2=1 := by rw [he]; exact h
  simpa only [he] using hc b j hl hh

