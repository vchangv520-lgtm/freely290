module

public import Freely290.PrimeRadicalCoset
public import Mathlib.LinearAlgebra.QuadraticForm.Basic

/-! Intrinsic version of the common-sign lifting argument. The sole radical
line of the norm modulo the prime is generated by an explicit integral vector. -/

@[expose] public section
namespace Freely290

structure PrimeNormRadicalLine {l : ℕ} (Q : QuadraticForm ℤ (Fin l → ℤ)) (p : ℤ) where
  generator : Fin l → ℤ
  position : Fin l
  unit : ℤ
  norm : Q generator = p*unit
  unit_coprime : ¬ p ∣ unit
  polar : ∀ u, p ∣ QuadraticMap.polar Q generator u
  line : ∀ x, p ∣ Q x → ∀ i, p ∣ x i-x position*generator i

theorem PrimeNormRadicalLine.same_sign {l : ℕ} {Q : QuadraticForm ℤ (Fin l → ℤ)} {p : ℤ}
    (C : PrimeNormRadicalLine Q p) (hp : Prime p) (x y : Fin l → ℤ)
    (hx : p ∣ Q x) (hy : p ∣ Q y) (heq : p^2 ∣ Q x-Q y) :
    ∃ s : ℤ, (s=1 ∨ s= -1) ∧ ∀ i, p ∣ x i-s*y i := by
  have norm (v : Fin l → ℤ) (h : p ∣ Q v) : p^2 ∣ Q v-(v C.position)^2*Q C.generator := by
    choose u hu using C.line v h
    let a := v C.position
    have he : a • C.generator + p • u = v := by
      funext i
      change a*C.generator i+p*u i=v i
      linear_combination -(hu i)
    obtain ⟨k,hk⟩ := C.polar u
    have hsum := QuadraticMap.map_add Q (a • C.generator) (p • u)
    rw [he,Q.map_smul,Q.map_smul,Q.polar_smul_left,Q.polar_smul_right,hk] at hsum
    simp only [smul_eq_mul] at hsum
    refine ⟨Q u+a*k,?_⟩
    change Q v-a^2*Q C.generator = _
    linear_combination hsum
  obtain ⟨u,hu⟩ := norm x hx
  obtain ⟨v,hv⟩ := norm y hy
  obtain ⟨k,hk⟩ := heq
  rw [C.norm] at hu hv
  have hprod : p ∣ (x C.position-y C.position)*(x C.position+y C.position) := by
    have hh : p ∣ C.unit*((x C.position-y C.position)*(x C.position+y C.position)) := by
      refine ⟨k-u+v,?_⟩
      apply mul_left_cancel₀ hp.ne_zero (a:=p)
      linear_combination hk-hu+hv
    exact (hp.dvd_or_dvd hh).resolve_left C.unit_coprime
  have hsign : ∃ s : ℤ, (s=1 ∨ s= -1) ∧ p ∣ x C.position-s*y C.position := by
    rcases hp.dvd_or_dvd hprod with h | h
    · exact ⟨1,Or.inl rfl,by simpa using h⟩
    · exact ⟨-1,Or.inr rfl,by simpa using h⟩
  obtain ⟨s,hs,⟨r,hr⟩⟩ := hsign
  refine ⟨s,hs,?_⟩
  intro i
  obtain ⟨t,ht⟩ := C.line x hx i
  obtain ⟨w,hw⟩ := C.line y hy i
  refine ⟨t-s*w+r*C.generator i,?_⟩
  linear_combination ht-s*hw+C.generator i*hr

end Freely290
