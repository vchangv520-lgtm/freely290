private def candidate22Natural42PackedRow (r : Fin 588) : Prop :=
  BitPlane.rangeCheck 1 588 (candidate22Natural42PackedTail.cost r) r.val (candidate22Natural42PackedStart r)
    (candidate22Natural42PackedBatches (candidate22Natural42PackedWhich r)).edges (candidate22Natural42PackedBatches (candidate22Natural42PackedWhich r)).target=true ∨ ¬Squarefree (Nat.gcd r.val 588)

private instance (r : Fin 588) : Decidable (candidate22Natural42PackedRow r) := by unfold candidate22Natural42PackedRow; infer_instance

