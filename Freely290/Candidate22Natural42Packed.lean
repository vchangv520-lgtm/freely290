  apply candidate22Natural42PackedTail.universal_of_bitplane_sf_rows_comp candidate22Natural42PackedCoeff (by decide +kernel) candidate22Natural42PackedBatches candidate22Natural42PackedStep
    (by decide) candidate22Natural42PackedChecks candidate22Natural42PackedWhich candidate22Natural42PackedStart candidate22Natural42PackedCover _ hc f hf
  have noEx : ∀ j, (candidate22Natural42PackedBatches j).exceptions=[] := by decide +kernel
  intro j e he
  rw [noEx j] at he
