private theorem candidate22Natural42PackedCover (r : Fin 588) : candidate22Natural42PackedRow r := by
  let b : Fin 5 := ⟨r.val/128,by omega⟩
  let t : Fin 128 := ⟨r.val%128,Nat.mod_lt _ (by decide)⟩
  have he : 128*b.val+t.val=r.val := by dsimp [b,t];omega
  have allRows : ∀ k : Fin 5, ∀ t : Fin 128, ∀ h : 128*k.val+t.val<588, candidate22Natural42PackedRow ⟨128*k.val+t.val,h⟩ := by
    intro k
    fin_cases k
    · exact candidate22Natural42PackedRows000
    · exact candidate22Natural42PackedRows001
    · exact candidate22Natural42PackedRows002
    · exact candidate22Natural42PackedRows003
    · exact candidate22Natural42PackedRows004
  have good := allRows b t (by rw [he]; exact r.isLt)
  simpa only [he] using good

