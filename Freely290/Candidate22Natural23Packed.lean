    (hf : Q.comp f=candidate22Natural23Matrix.toQuadraticForm') : Universal Q := by
  apply candidate22Natural23PackedTail.universal_of_bitplane_sf_rows_comp candidate22Natural23PackedCoeff (by decide +kernel) candidate22Natural23PackedBatches candidate22Natural23PackedStep
    (by decide) candidate22Natural23PackedChecks candidate22Natural23PackedWhich candidate22Natural23PackedStart candidate22Natural23PackedCover _ hc f hf
  have noEx : ∀ j, (candidate22Natural23PackedBatches j).exceptions=[] := by decide +kernel
  intro j e he
  rw [noEx j] at he
