private def candidate22Natural23PackedRow (r : Fin 588) : Prop :=
  BitPlane.rangeCheck 1 588 (candidate22Natural23PackedTail.cost r) r.val (candidate22Natural23PackedStart r)
    (candidate22Natural23PackedBatches (candidate22Natural23PackedWhich r)).edges (candidate22Natural23PackedBatches (candidate22Natural23PackedWhich r)).target=true ∨ ¬Squarefree (Nat.gcd r.val 588)

private instance (r : Fin 588) : Decidable (candidate22Natural23PackedRow r) := by unfold candidate22Natural23PackedRow; infer_instance

