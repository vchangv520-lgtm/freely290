def groupedResidueOrbits010MapAt (k : ℕ) : ℕ := ((groupedResidueOrbits010MapAtWords (k/32)) >>> (12*(k%32))) % 4096
def groupedResidueOrbits010Rep (s : Fin 256) : Fin 3 → Fin 10 :=
  let v := groupedResidueOrbits010RepAt s.val
  ![⟨v/100%10,Nat.mod_lt _ (by decide)⟩,⟨v/10%10,Nat.mod_lt _ (by decide)⟩,⟨v%10,Nat.mod_lt _ (by decide)⟩]
def groupedResidueOrbits010Code (r : Fin 3 → Fin 10) : ℕ :=
  groupedResidueOrbits010MapAt ((r 0).val*100+(r 1).val*10+(r 2).val)
def groupedResidueOrbits010Orbit (r : Fin 3 → Fin 10) : Fin 256 := ⟨(groupedResidueOrbits010Code r/10)%256,Nat.mod_lt _ (by decide)⟩
def groupedResidueOrbits010Unit (r : Fin 3 → Fin 10) : Fin 10 := ⟨groupedResidueOrbits010Code r%10,Nat.mod_lt _ (by decide)⟩
def groupedResidueOrbits010OK (r : Fin 3 → Fin 10) : Bool :=
  let u := (groupedResidueOrbits010Unit r).val
  let v := groupedResidueOrbits010Rep (groupedResidueOrbits010Orbit r)
  decide (u.Coprime 10 ∧ ∀ j : Fin 3, (r j).val = (u*(v j).val)%10)

