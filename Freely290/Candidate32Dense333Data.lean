module

public import Freely290.Candidate32DenseInitialCore

@[expose] public section

namespace Freely290

set_option maxHeartbeats 8000000
set_option maxRecDepth 30000

open BitPlane

def candidate32Dense333Matrix : Matrix (Fin 4) (Fin 4) ℤ := ![![1, 0, 0, -3], ![0, 2, -1, -4], ![0, 0, 5, 1], ![0, 0, 0, 13]]
def candidate32Dense333Coeffs : CompactQuaternaryCoefficients := ⟨1, 2, 5, 13, 0, 0, -3, -1, -4, 1⟩
def candidate32Dense333Coordinates : BitPlane.Vector := ⟨⟨[, , , , , , ], []⟩,
⟨[, , , , , ], [, , , , , ]⟩,
⟨[], [, , , , , ]⟩,
⟨[], []⟩⟩
def candidate32Dense333Targets : Words := [, , , , , , , , , , , , ]
def candidate32Dense333Edges : ℕ := 

theorem candidate32Dense333Values : (quadratic candidate32Dense333Coeffs candidate32Dense333Coordinates).check ⟨candidate32Dense333Targets, []⟩ = true := by decide +kernel
theorem candidate32Dense333Steps : stepCheck candidate32Dense333Targets candidate32Dense333Edges [true] = true := by decide +kernel
theorem candidate32Dense333Range : rangeCheck 1 1 7800 0 0 candidate32Dense333Edges candidate32Dense333Targets = true := by decide +kernel

theorem candidate32Dense333Initial (n : ℕ) (hn : n ≤ 7800) : Represents candidate32Dense333Matrix.toQuadraticForm' n :=
  candidate32DenseInitial (by decide +kernel : compactQuaternaryCoefficients candidate32Dense333Matrix = candidate32Dense333Coeffs)
    candidate32Dense333Values candidate32Dense333Steps candidate32Dense333Range (by decide) hn

end Freely290
