theorem candidate26OrdinaryD7Isotropic : ∀ r, (17 : ℤ) ∣ splitPrimeNorm (splitPrimeChartVector r) →
    ∀ j, residueDivisibilityCheck (candidate26OrdinaryD7Frames (candidate26OrdinaryD7Line r) j) 17 (splitPrimeChartVector r) = true := by
