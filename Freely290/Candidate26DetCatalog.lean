module

public import Freely290.Candidate26FullUpgradeTargets
public import Freely290.Candidate26SplitDiscriminant

@[expose] public section
namespace Freely290

set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace Candidate26DetCatalog

def index (delta : ℕ) : Fin 236 :=
  ⟨((( : ℕ) >>> (8*delta))%256)%236,Nat.mod_lt _ (by decide)⟩

private def value (i : Fin 236) : ℕ :=
  (( : ℕ) >>> (11*i.val))%2048

private def numeric (c : Candidate26FullUpgradeCode) : Prop :=
  let d := candidate26FullUpgradeDelta c
  0≤d → (value (index d.toNat):ℤ)=d

private instance (c : Candidate26FullUpgradeCode) : Decidable (numeric c) := by unfold numeric; infer_instance

private theorem target_norm (i : Fin 236) :
    1360-Candidate26SplitDiscriminant.candidate26SplitDiscriminantNorm (candidate26FullUpgradeQuadTargetCross i)=(value i:ℤ) := by
  revert i
  decide +kernel

private theorem numeric00 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (0,b,z) := by decide +kernel

private theorem numeric01 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (1,b,z) := by decide +kernel

private theorem numeric02 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (2,b,z) := by decide +kernel

private theorem numeric03 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (3,b,z) := by decide +kernel

private theorem numeric04 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (4,b,z) := by decide +kernel

private theorem numeric05 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (5,b,z) := by decide +kernel

private theorem numeric06 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (6,b,z) := by decide +kernel

private theorem numeric07 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (7,b,z) := by decide +kernel

private theorem numeric08 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (8,b,z) := by decide +kernel

private theorem numeric09 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (9,b,z) := by decide +kernel

private theorem numeric10 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (10,b,z) := by decide +kernel

private theorem numeric11 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (11,b,z) := by decide +kernel

private theorem numeric12 : ∀ b : Fin 17, ∀ z : Fin 29, numeric (12,b,z) := by decide +kernel

private theorem checked (c : Candidate26FullUpgradeCode) : numeric c := by
  rcases c with ⟨a,b,z⟩
  fin_cases a
  · exact numeric00 b z
  · exact numeric01 b z
  · exact numeric02 b z
  · exact numeric03 b z
  · exact numeric04 b z
  · exact numeric05 b z
  · exact numeric06 b z
  · exact numeric07 b z
  · exact numeric08 b z
  · exact numeric09 b z
  · exact numeric10 b z
  · exact numeric11 b z
  · exact numeric12 b z

private theorem source_norm (c : Candidate26FullUpgradeCode) :
    1360-Candidate26SplitDiscriminant.candidate26SplitDiscriminantNorm (candidate26FullUpgradeA c)=candidate26FullUpgradeDelta c := by
  simp [Candidate26SplitDiscriminant.candidate26SplitDiscriminantNorm,candidate26FullUpgradeDelta,candidate26FullUpgradeAdjugateCross]
  ring

theorem classify (c : Candidate26FullUpgradeCode) (hc : Candidate26FullUpgradeValid c) :
    ∃ (i : Fin 236) (f : (Fin 4 → ℤ) →ₗ[ℤ] (Fin 4 → ℤ)),
      (candidate26FullUpgradeMatrix c).toQuadraticForm'.comp f=(candidate26FullUpgradeQuadTarget i).toQuadraticForm' := by
  let i := index (candidate26FullUpgradeDelta c).toNat
  have h₁ : (value i:ℤ)=candidate26FullUpgradeDelta c := checked c hc
  have h₂ := target_norm i
  have h₃ := source_norm c
  have hn : Candidate26SplitDiscriminant.candidate26SplitDiscriminantNorm (candidate26FullUpgradeA c)=Candidate26SplitDiscriminant.candidate26SplitDiscriminantNorm (candidate26FullUpgradeQuadTargetCross i) := by omega
  obtain ⟨f,hf⟩ := Candidate26SplitDiscriminant.embed 10 (candidate26FullUpgradeA c) (candidate26FullUpgradeQuadTargetCross i) hn
  exact ⟨i,f,hf⟩

end Candidate26DetCatalog

end Freely290
