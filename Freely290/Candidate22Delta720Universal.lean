theorem candidate22Delta720_represents_initial {n : ℕ} (hn : n ≤ 11340) :
    Represents candidate22Delta720Matrix.toQuadraticForm' n := by
  let b : Fin 355 := ⟨n / 32, by omega⟩
  let r : Fin 32 := ⟨n % 32, Nat.mod_lt _ (by decide)⟩
  have he : 32 * b.val + r.val = n := by dsimp [b, r]; omega
  simpa only [he] using candidate22Delta720_all_blocks b r (by omega)

theorem candidate22Delta720_universal : Universal candidate22Delta720Matrix.toQuadraticForm' := by
