private def candidate22Natural33PackedRow (r : Fin 588) : Prop :=
  BitPlane.rangeCheck 1 588 (candidate22Natural33PackedTail.cost r) r.val (candidate22Natural33PackedStart r)
    (candidate22Natural33PackedBatches (candidate22Natural33PackedWhich r)).edges (candidate22Natural33PackedBatches (candidate22Natural33PackedWhich r)).target=true ∨ ¬Squarefree (Nat.gcd r.val 588)

private instance (r : Fin 588) : Decidable (candidate22Natural33PackedRow r) := by unfold candidate22Natural33PackedRow; infer_instance

