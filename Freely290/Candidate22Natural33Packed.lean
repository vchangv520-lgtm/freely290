    (by decide) candidate22Natural33PackedChecks candidate22Natural33PackedWhich candidate22Natural33PackedStart candidate22Natural33PackedCover _ hc f hf
  have admissible : ∀ j, (candidate22Natural33PackedBatches j).admissibleExceptions=true := by decide +kernel
  intro j e he
