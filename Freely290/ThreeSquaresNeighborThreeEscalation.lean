/-- All positive squarefree values outside the two critical exceptions are represented. -/
theorem threeSquaresNeighborThreeUpgrade_represents_squarefree_of_ne_critical
    (c : ThreeSquaresNeighborThreeUpgradeCode) (hc : ThreeSquaresNeighborThreeUpgradeValid c) {n : ℕ}
    (hn : 0 < n) (hs : Squarefree n) (hn15 : n ≠ 15) (hn23 : n ≠ 23) :
    Represents (threeSquaresNeighborThreeUpgradeForm c) n := by
  have h := threeSquaresNeighborThreeUpgradeLookup_checked c.1 c.2.1 c.2.2 hc
  exact (matrixChangeOfBasisCheck_represents_iff h n).mpr
    (threeSquaresNeighborThreeUpgradeRepresentative_represents_squarefree_of_ne_critical
      (threeSquaresNeighborThreeUpgradeLookup c.1 c.2.1 c.2.2).1 hn hs hn15 hn23)

variable {M : Type*} [AddCommGroup M]

/-- The two critical representations are supplied in the same ambient form. -/
theorem threeSquaresNeighborThreeUpgrade_universal_of_comp_and_critical {Q : QuadraticForm ℤ M}
    (c : ThreeSquaresNeighborThreeUpgradeCode) (hc : ThreeSquaresNeighborThreeUpgradeValid c)
    (f : (Fin 4 → ℤ) →ₗ[ℤ] M) (hf : Q.comp f = threeSquaresNeighborThreeUpgradeForm c)
    (h15 : Represents Q 15) (h23 : Represents Q 23) : Universal Q := by
  apply universal_iff_squarefree_representation.mpr
  intro n hn hs
  by_cases hn15 : n = 15
  · simpa only [hn15] using h15
  · by_cases hn23 : n = 23
    · simpa only [hn23] using h23
    · apply represents_of_comp f
      rw [hf]
      exact threeSquaresNeighborThreeUpgrade_represents_squarefree_of_ne_critical c hc hn hs hn15 hn23

