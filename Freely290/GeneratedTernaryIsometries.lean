theorem validTernaryCode_represents_iff_representative (c : ValidTernaryCode) :
    ∃ i : Fin 35, ∀ n : ℕ,
      Represents (ternaryForm c.val) n ↔ Represents (ternaryRepresentativeForm i) n := by
  obtain ⟨i, T, hT⟩ := validTernaryCode_changeOfBasis_representative c
  exact ⟨i, fun n ↦ matrixChangeOfBasisCheck_represents_iff hT n⟩

/-- The remaining ternary coverage may be consumed without the raw duplicate codes. -/
theorem validTernaryCode_universal_iff_representative (c : ValidTernaryCode) :
    ∃ i : Fin 35, Universal (ternaryForm c.val) ↔ Universal (ternaryRepresentativeForm i) := by
  obtain ⟨i, T, hT⟩ := validTernaryCode_changeOfBasis_representative c
  exact ⟨i, matrixChangeOfBasisCheck_universal_iff hT⟩

end Freely290
