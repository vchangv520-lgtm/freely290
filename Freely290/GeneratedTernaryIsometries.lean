module

public import Freely290.TernaryClassification
public import Freely290.IntegralEquivalence

/-!
# Certified coverage of 173 raw ternary codes by 35 representatives

The list supplies coverage, with an integer bijective coordinate substitution
for every valid raw code. Pairwise inequivalence or minimality of the 35 entries
is not needed or asserted. Literal data is generated by
scripts/emit_ternary_isometries.py; every accepted substitution is checked by
the kernel through matrixChangeOfBasisCheck.
-/

@[expose] public section

namespace Freely290

set_option maxRecDepth 20000
set_option maxHeartbeats 4000000

/-- The selected representatives retain the previously checked truant records. -/
def ternaryRepresentativeCertificate : Fin 35 → TernaryTruantCertificate :=
  ![ternaryRecord000, ternaryRecord001, ternaryRecord003, ternaryRecord004, ternaryRecord005, ternaryRecord010, ternaryRecord011, ternaryRecord018, ternaryRecord038, ternaryRecord042, ternaryRecord043, ternaryRecord044, ternaryRecord050, ternaryRecord051, ternaryRecord057, ternaryRecord059, ternaryRecord060, ternaryRecord089, ternaryRecord091, ternaryRecord092, ternaryRecord093, ternaryRecord099, ternaryRecord100, ternaryRecord101, ternaryRecord102, ternaryRecord103, ternaryRecord112, ternaryRecord113, ternaryRecord114, ternaryRecord115, ternaryRecord123, ternaryRecord124, ternaryRecord126, ternaryRecord127, ternaryRecord128]

def ternaryRepresentativeCode (i : Fin 35) : TernaryCode :=
  (ternaryRepresentativeCertificate i).code

def ternaryRepresentativeForm (i : Fin 35) : QuadraticForm ℤ (Fin 3 → ℤ) :=
  ternaryForm (ternaryRepresentativeCode i)

def ternaryRepresentativeCodes : List TernaryCode :=
  List.ofFn ternaryRepresentativeCode

theorem ternaryRepresentativeCodes_length : ternaryRepresentativeCodes.length = 35 := by
  simp [ternaryRepresentativeCodes]

theorem ternaryRepresentativeCode_valid :
    ∀ i : Fin 35, TernaryValid (ternaryRepresentativeCode i) := by
  decide +kernel

theorem ternaryRepresentativeForm_posDef (i : Fin 35) :
    (ternaryRepresentativeForm i).PosDef :=
  (ternaryRepresentativeCertificate i).posDef

theorem ternaryRepresentativeForm_has_critical_truant (i : Fin 35) :
    ∃ t ∈ critical, Truant (ternaryRepresentativeForm i) t :=
  ⟨(ternaryRepresentativeCertificate i).data.truant,
    (ternaryRepresentativeCertificate i).critical,
    (ternaryRepresentativeCertificate i).truant⟩

/-- Proof-carrying coordinate substitution from a raw code to a selected representative. -/
structure TernaryIsometryCertificate where
  target : TernaryCode
  representative : Fin 35
  change : Matrix (Fin 3) (Fin 3) ℤ
  checked : matrixChangeOfBasisCheck
    (ternaryUpperMatrix (ternaryRepresentativeCode representative))
    (ternaryUpperMatrix target) change = true

theorem TernaryIsometryCertificate.represents_iff (C : TernaryIsometryCertificate) (n : ℕ) :
    Represents (ternaryForm C.target) n ↔
      Represents (ternaryRepresentativeForm C.representative) n :=
  matrixChangeOfBasisCheck_represents_iff C.checked n

theorem TernaryIsometryCertificate.universal_iff (C : TernaryIsometryCertificate) :
    Universal (ternaryForm C.target) ↔
      Universal (ternaryRepresentativeForm C.representative) :=
  matrixChangeOfBasisCheck_universal_iff C.checked

theorem TernaryIsometryCertificate.truant_iff (C : TernaryIsometryCertificate) (t : ℕ) :
    Truant (ternaryForm C.target) t ↔
      Truant (ternaryRepresentativeForm C.representative) t :=
  matrixChangeOfBasisCheck_truant_iff C.checked t

def ternaryIsometry000Change : Matrix (Fin 3) (Fin 3) ℤ :=
  ![![1, 0, 0], ![0, 1, 0], ![0, 0, 1]]

theorem ternaryIsometry000_checked :
    matrixChangeOfBasisCheck
      (ternaryUpperMatrix (ternaryRepresentativeCode 0))
      (ternaryUpperMatrix ternaryRecord000Code) ternaryIsometry000Change = true := by
  decide +kernel

def ternaryIsometry000 : TernaryIsometryCertificate where
  target := ternaryRecord000Code
  representative := 0
  change := ternaryIsometry000Change
  checked := ternaryIsometry000_checked

