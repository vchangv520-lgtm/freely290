private def candidate25ClosedTernarySubformsCheck (r : Fin 89) : Bool :=
  matrixSubformCheck (candidate25FullUpgradeQuadTarget (candidate25ClosedTernarySubformsIndex r))
    (ternaryUpperMatrix (ternarySubformCandidateCode (candidate25ClosedTernarySubformsBranch r).index)) (candidate25ClosedTernarySubformsEmbedding r)

