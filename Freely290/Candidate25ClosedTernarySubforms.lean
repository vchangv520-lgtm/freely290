private theorem candidate25ClosedTernarySubformsValid : ∀ r : Fin 89, candidate25ClosedTernarySubformsCheck r = true := by
  apply forall_fin_of_bool_tiles (depth := 3) (count := 12) (by decide)
  intro i
  fin_cases i
  · exact candidate25ClosedTernarySubformsTile0
  · exact candidate25ClosedTernarySubformsTile1
  · exact candidate25ClosedTernarySubformsTile2
  · exact candidate25ClosedTernarySubformsTile3
  · exact candidate25ClosedTernarySubformsTile4
  · exact candidate25ClosedTernarySubformsTile5
  · exact candidate25ClosedTernarySubformsTile6
  · exact candidate25ClosedTernarySubformsTile7
  · exact candidate25ClosedTernarySubformsTile8
  · exact candidate25ClosedTernarySubformsTile9
  · exact candidate25ClosedTernarySubformsTile10
  · exact candidate25ClosedTernarySubformsTile11

theorem candidate25ClosedTernarySubforms_universal_of_comp (r : Fin 89) {M : Type*} [AddCommGroup M] {Q : QuadraticForm ℤ M}
    (hQ : ∀ x, 0 ≤ Q x) (hc : Checks Q critical) (f : (Fin 4 → ℤ) →ₗ[ℤ] M)
    (hf : Q.comp f = (candidate25FullUpgradeQuadTarget (candidate25ClosedTernarySubformsIndex r)).toQuadraticForm') : Universal Q :=
  (candidate25ClosedTernarySubformsBranch r).universal_of_matrix (candidate25ClosedTernarySubformsEmbedding r) (candidate25ClosedTernarySubformsValid r) hQ hc f hf

