module

public import Freely290.DiscriminantBitCover
public import Freely290.Candidate23DiscriminantShear
public import Freely290.Candidate23FullUpgradeTargets

@[expose] public section
namespace Freely290

set_option maxRecDepth 30000
set_option maxHeartbeats 4000000


def candidate23DiscriminantMask : ℕ := 
private def candidate23DiscriminantOmitted : ℕ := 
private theorem candidate23DiscriminantOmitted_eq : candidate23DiscriminantOmitted = (2^7689-1) ^^^ candidate23DiscriminantMask := by decide +kernel

private def candidate23DiscriminantSquares (r : ℕ) : ℕ :=
  (#[,,,] : Array ℕ).getD r 0

private def candidate23DiscriminantSignedSquare (i : Fin 311) : Bool :=
  let n : ℤ := (i.val:ℤ)-155
  (candidate23DiscriminantSquares (n%4).toNat).testBit (n^2).toNat

private theorem candidate23DiscriminantSquares_spec (v : ℤ) (hv₀ : -155 ≤ v) (hv₁ : v ≤ 155) :
    (candidate23DiscriminantSquares (v%4).toNat).testBit (v^2).toNat = true := by
  have all : ∀ i : Fin 311, candidate23DiscriminantSignedSquare i=true := by decide +kernel
  let i : Fin 311 := ⟨(v+155).toNat,by omega⟩
  have e : (i.val:ℤ)-155=v := by dsimp [i]; omega
  simpa only [candidate23DiscriminantSignedSquare,e] using all i

private def candidate23DiscriminantSquareClass (a : Fin 23) (b : Fin 31) : ℕ :=
  ((4*((a.val:ℤ)-11)+1*((b.val:ℤ)-15))%4).toNat

private def candidate23DiscriminantSquareOffset (a : Fin 23) (b : Fin 31) : ℤ :=
  31*(2*((a.val:ℤ)-11)^2+((b.val:ℤ)-15)^2)

private theorem candidate23DiscriminantSquareCoverage (a : Fin 23) (b : Fin 31) :
    ((candidate23DiscriminantSquares (candidate23DiscriminantSquareClass a b)) <<< (candidate23DiscriminantSquareOffset a b).toNat) &&& candidate23DiscriminantOmitted = 0 := by
  revert b
  fin_cases a <;> decide +kernel

theorem candidate23DiscriminantKey_identity (a : Fin 3 → ℤ) :
    2*candidate23DiscriminantShearNorm a = (4*a 0+1*a 1+4*a 2)^2+31*(2*(a 0)^2+(a 1)^2) := by
  unfold candidate23DiscriminantShearNorm
  ring

theorem candidate23DiscriminantNorm_nonneg (a : Fin 3 → ℤ) : 0 ≤ candidate23DiscriminantShearNorm a := by
  have h := candidate23DiscriminantKey_identity a
  nlinarith [sq_nonneg (a 0),sq_nonneg (a 1),sq_nonneg (4*a 0+1*a 1+4*a 2)]

theorem candidate23DiscriminantMask_of_valid (c : Candidate23FullUpgradeCode) (hv : Candidate23FullUpgradeValid c) :
    candidate23DiscriminantMask.testBit (2*candidate23DiscriminantShearNorm (candidate23FullUpgradeA c)).toNat = true := by
  rcases c with ⟨a,b,d⟩
  let v := 4*((a.val:ℤ)-11)+1*((b.val:ℤ)-15)+4*((d.val:ℤ)-24)
  have vlow : -155 ≤ v := by dsimp [v]; omega
  have vhigh : v ≤ 155 := by dsimp [v]; omega
  have r : (v%4).toNat = candidate23DiscriminantSquareClass a b := by
    unfold candidate23DiscriminantSquareClass
    dsimp [v]
    congr 1
    omega
  have sq := candidate23DiscriminantSquares_spec v vlow vhigh
  rw [r] at sq
  have e : 2*candidate23DiscriminantShearNorm (candidate23FullUpgradeA (a,b,d)) = v^2+candidate23DiscriminantSquareOffset a b := by
    rw [candidate23DiscriminantKey_identity]
    rfl
  have off : 0 ≤ candidate23DiscriminantSquareOffset a b := by unfold candidate23DiscriminantSquareOffset; positivity
  have rawDelta : candidate23FullUpgradeDelta (a,b,d) = 3844-candidate23DiscriminantShearNorm (candidate23FullUpgradeA (a,b,d)) := by
    change 3844-(candidate23FullUpgradeA (a,b,d) 0)*(39*(candidate23FullUpgradeA (a,b,d) 0)+2*(candidate23FullUpgradeA (a,b,d) 1)+8*(candidate23FullUpgradeA (a,b,d) 2))-(candidate23FullUpgradeA (a,b,d) 1)*(2*(candidate23FullUpgradeA (a,b,d) 0)+16*(candidate23FullUpgradeA (a,b,d) 1)+2*(candidate23FullUpgradeA (a,b,d) 2))-(candidate23FullUpgradeA (a,b,d) 2)*(8*(candidate23FullUpgradeA (a,b,d) 0)+2*(candidate23FullUpgradeA (a,b,d) 1)+8*(candidate23FullUpgradeA (a,b,d) 2)) = _
    unfold candidate23DiscriminantShearNorm
    ring
  change 0 ≤ candidate23FullUpgradeDelta (a,b,d) at hv
  rw [rawDelta] at hv
  have hs : 0 ≤ v^2 := sq_nonneg _
  have hn : (2*candidate23DiscriminantShearNorm (candidate23FullUpgradeA (a,b,d))).toNat = (v^2).toNat+(candidate23DiscriminantSquareOffset a b).toNat := by omega
  rw [hn]
  apply discriminantMask_shift candidate23DiscriminantOmitted_eq (candidate23DiscriminantSquareCoverage a b) sq
  omega

end Freely290
