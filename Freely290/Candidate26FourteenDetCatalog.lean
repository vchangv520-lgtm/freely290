module

public import Freely290.Candidate26FourteenTargets
public import Freely290.Candidate26SplitDiscriminant

@[expose] public section
namespace Freely290

set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace Candidate26FourteenDetCatalog

def index (delta : ℕ) : Fin 330 :=
  ⟨((( : ℕ) >>> (9*delta))%512)%330,Nat.mod_lt _ (by decide)⟩

private def value (i : Fin 330) : ℕ :=
  (( : ℕ) >>> (11*i.val))%2048

private def numeric (c : Candidate26FourteenCode) : Prop :=
  let d := candidate26FourteenDelta c
  0≤d → (value (index d.toNat):ℤ)=d

private instance (c : Candidate26FourteenCode) : Decidable (numeric c) := by unfold numeric; infer_instance

private theorem target_norm (i : Fin 330) :
    1904-Candidate26SplitDiscriminant.candidate26SplitDiscriminantNorm (candidate26FourteenTargetCross i)=(value i:ℤ) := by
  revert i
  decide +kernel

private theorem numeric00 : ∀ b : Fin 21, ∀ z : Fin 33, numeric (0,b,z) := by decide +kernel

private theorem numeric01 : ∀ b : Fin 21, ∀ z : Fin 33, numeric (1,b,z) := by decide +kernel

private theorem numeric02 : ∀ b : Fin 21, ∀ z : Fin 33, numeric (2,b,z) := by decide +kernel

private theorem numeric03 : ∀ b : Fin 21, ∀ z : Fin 33, numeric (3,b,z) := by decide +kernel

private theorem numeric04 : ∀ b : Fin 21, ∀ z : Fin 33, numeric (4,b,z) := by decide +kernel

private theorem numeric05 : ∀ b : Fin 21, ∀ z : Fin 33, numeric (5,b,z) := by decide +kernel

private theorem numeric06 : ∀ b : Fin 21, ∀ z : Fin 33, numeric (6,b,z) := by decide +kernel

private theorem numeric07 : ∀ b : Fin 21, ∀ z : Fin 33, numeric (7,b,z) := by decide +kernel

private theorem numeric08 : ∀ b : Fin 21, ∀ z : Fin 33, numeric (8,b,z) := by decide +kernel

private theorem numeric09 : ∀ b : Fin 21, ∀ z : Fin 33, numeric (9,b,z) := by decide +kernel

private theorem numeric10 : ∀ b : Fin 21, ∀ z : Fin 33, numeric (10,b,z) := by decide +kernel

private theorem numeric11 : ∀ b : Fin 21, ∀ z : Fin 33, numeric (11,b,z) := by decide +kernel

private theorem numeric12 : ∀ b : Fin 21, ∀ z : Fin 33, numeric (12,b,z) := by decide +kernel

private theorem numeric13 : ∀ b : Fin 21, ∀ z : Fin 33, numeric (13,b,z) := by decide +kernel

private theorem numeric14 : ∀ b : Fin 21, ∀ z : Fin 33, numeric (14,b,z) := by decide +kernel

private theorem checked (c : Candidate26FourteenCode) : numeric c := by
  rcases c with ⟨a,b,z⟩
  fin_cases a
  · exact numeric00 b z
  · exact numeric01 b z
  · exact numeric02 b z
  · exact numeric03 b z
  · exact numeric04 b z
  · exact numeric05 b z
  · exact numeric06 b z
  · exact numeric07 b z
  · exact numeric08 b z
  · exact numeric09 b z
  · exact numeric10 b z
  · exact numeric11 b z
  · exact numeric12 b z
  · exact numeric13 b z
  · exact numeric14 b z

private theorem source_norm (c : Candidate26FourteenCode) :
    1904-Candidate26SplitDiscriminant.candidate26SplitDiscriminantNorm (candidate26FourteenCross c)=candidate26FourteenDelta c := by
  simp [Candidate26SplitDiscriminant.candidate26SplitDiscriminantNorm,candidate26FourteenDelta,candidate26FourteenAdjugateCross]
  ring

theorem classify (c : Candidate26FourteenCode) (hc : Candidate26FourteenValid c) :
    ∃ (i : Fin 330) (f : (Fin 4 → ℤ) →ₗ[ℤ] (Fin 4 → ℤ)),
      (candidate26FourteenMatrix c).toQuadraticForm'.comp f=(candidate26FourteenTarget i).toQuadraticForm' := by
  let i := index (candidate26FourteenDelta c).toNat
  have h₁ : (value i:ℤ)=candidate26FourteenDelta c := checked c hc
  have h₂ := target_norm i
  have h₃ := source_norm c
  have hn : Candidate26SplitDiscriminant.candidate26SplitDiscriminantNorm (candidate26FourteenCross c)=Candidate26SplitDiscriminant.candidate26SplitDiscriminantNorm (candidate26FourteenTargetCross i) := by omega
  obtain ⟨f,hf⟩ := Candidate26SplitDiscriminant.embed 14 (candidate26FourteenCross c) (candidate26FourteenTargetCross i) hn
  exact ⟨i,f,hf⟩

end Candidate26FourteenDetCatalog

end Freely290
