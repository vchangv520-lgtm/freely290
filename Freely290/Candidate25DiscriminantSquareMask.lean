module

public import Freely290.DiscriminantBitCover
public import Freely290.Candidate25DiscriminantShear
public import Freely290.Candidate25FullUpgradeTargets

@[expose] public section
namespace Freely290

set_option maxRecDepth 30000
set_option maxHeartbeats 4000000


def candidate25DiscriminantMask : ℕ := 
private def candidate25DiscriminantOmitted : ℕ := 
private theorem candidate25DiscriminantOmitted_eq : candidate25DiscriminantOmitted = (2^6729-1) ^^^ candidate25DiscriminantMask := by decide +kernel

private def candidate25DiscriminantSquares (r : ℕ) : ℕ :=
  (#[,,,] : Array ℕ).getD r 0

private def candidate25DiscriminantSignedSquare (i : Fin 323) : Bool :=
  let n : ℤ := (i.val:ℤ)-161
  (candidate25DiscriminantSquares (n%4).toNat).testBit (n^2).toNat

private theorem candidate25DiscriminantSquares_spec (v : ℤ) (hv₀ : -161 ≤ v) (hv₁ : v ≤ 161) :
    (candidate25DiscriminantSquares (v%4).toNat).testBit (v^2).toNat = true := by
  have all : ∀ i : Fin 323, candidate25DiscriminantSignedSquare i=true := by decide +kernel
  let i : Fin 323 := ⟨(v+161).toNat,by omega⟩
  have e : (i.val:ℤ)-161=v := by dsimp [i]; omega
  simpa only [candidate25DiscriminantSignedSquare,e] using all i

private def candidate25DiscriminantSquareClass (a : Fin 21) (b : Fin 31) : ℕ :=
  ((2*((a.val:ℤ)-10)+3*((b.val:ℤ)-15))%4).toNat

private def candidate25DiscriminantSquareOffset (a : Fin 21) (b : Fin 31) : ℤ :=
  29*(2*((a.val:ℤ)-10)^2+((b.val:ℤ)-15)^2)

private theorem candidate25DiscriminantSquareCoverage (a : Fin 21) (b : Fin 31) :
    ((candidate25DiscriminantSquares (candidate25DiscriminantSquareClass a b)) <<< (candidate25DiscriminantSquareOffset a b).toNat) &&& candidate25DiscriminantOmitted = 0 := by
  revert b
  fin_cases a <;> decide +kernel

theorem candidate25DiscriminantKey_identity (a : Fin 3 → ℤ) :
    2*candidate25DiscriminantShearNorm a = (2*a 0+3*a 1+4*a 2)^2+29*(2*(a 0)^2+(a 1)^2) := by
  unfold candidate25DiscriminantShearNorm
  ring

theorem candidate25DiscriminantNorm_nonneg (a : Fin 3 → ℤ) : 0 ≤ candidate25DiscriminantShearNorm a := by
  have h := candidate25DiscriminantKey_identity a
  nlinarith [sq_nonneg (a 0),sq_nonneg (a 1),sq_nonneg (2*a 0+3*a 1+4*a 2)]

theorem candidate25DiscriminantMask_of_valid (c : Candidate25FullUpgradeCode) (hv : Candidate25FullUpgradeValid c) :
    candidate25DiscriminantMask.testBit (2*candidate25DiscriminantShearNorm (candidate25FullUpgradeA c)).toNat = true := by
  rcases c with ⟨a,b,d⟩
  let v := 2*((a.val:ℤ)-10)+3*((b.val:ℤ)-15)+4*((d.val:ℤ)-24)
  have vlow : -161 ≤ v := by dsimp [v]; omega
  have vhigh : v ≤ 161 := by dsimp [v]; omega
  have r : (v%4).toNat = candidate25DiscriminantSquareClass a b := by
    unfold candidate25DiscriminantSquareClass
    dsimp [v]
    congr 1
    omega
  have sq := candidate25DiscriminantSquares_spec v vlow vhigh
  rw [r] at sq
  have e : 2*candidate25DiscriminantShearNorm (candidate25FullUpgradeA (a,b,d)) = v^2+candidate25DiscriminantSquareOffset a b := by
    rw [candidate25DiscriminantKey_identity]
    rfl
  have off : 0 ≤ candidate25DiscriminantSquareOffset a b := by unfold candidate25DiscriminantSquareOffset; positivity
  have rawDelta : candidate25FullUpgradeDelta (a,b,d) = 3364-candidate25DiscriminantShearNorm (candidate25FullUpgradeA (a,b,d)) := by
    change 3364-(candidate25FullUpgradeA (a,b,d) 0)*(31*(candidate25FullUpgradeA (a,b,d) 0)+3*(candidate25FullUpgradeA (a,b,d) 1)+4*(candidate25FullUpgradeA (a,b,d) 2))-(candidate25FullUpgradeA (a,b,d) 1)*(3*(candidate25FullUpgradeA (a,b,d) 0)+19*(candidate25FullUpgradeA (a,b,d) 1)+6*(candidate25FullUpgradeA (a,b,d) 2))-(candidate25FullUpgradeA (a,b,d) 2)*(4*(candidate25FullUpgradeA (a,b,d) 0)+6*(candidate25FullUpgradeA (a,b,d) 1)+8*(candidate25FullUpgradeA (a,b,d) 2)) = _
    unfold candidate25DiscriminantShearNorm
    ring
  change 0 ≤ candidate25FullUpgradeDelta (a,b,d) at hv
  rw [rawDelta] at hv
  have hs : 0 ≤ v^2 := sq_nonneg _
  have hn : (2*candidate25DiscriminantShearNorm (candidate25FullUpgradeA (a,b,d))).toNat = (v^2).toNat+(candidate25DiscriminantSquareOffset a b).toNat := by omega
  rw [hn]
  apply discriminantMask_shift candidate25DiscriminantOmitted_eq (candidate25DiscriminantSquareCoverage a b) sq
  omega

end Freely290
