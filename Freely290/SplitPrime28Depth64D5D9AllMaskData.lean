def splitPrime28Depth64D5D9AllMaskRequired : ℕ := 

def splitPrime28Depth64D5D9AllMaskTest (j : Fin 5760) : Bool :=
  (splitPrime28Depth64D5D9AllMaskDoubled.testBit j.val == splitPrime28Depth64D5D9AllMaskGood (j.val : ℤ)) &&
  (splitPrime28Depth64D5D9AllMaskRequired.testBit (j.val%2880) == splitPrime28Depth64D5D9AllMaskGuard (j.val%2880))

theorem splitPrime28Depth64D5D9AllMaskGuard_of_squarefree (r : Fin 2880) (hs : Squarefree (Nat.gcd r.val 2880))  :
    splitPrime28Depth64D5D9AllMaskGuard r.val=true := decide_eq_true ⟨(fun h ↦ Nat.squarefree_iff_prime_squarefree.mp hs 2 (by decide) (Nat.dvd_gcd (Nat.dvd_of_mod_eq_zero h) (by decide))), (fun h ↦ Nat.squarefree_iff_prime_squarefree.mp hs 3 (by decide) (Nat.dvd_gcd (Nat.dvd_of_mod_eq_zero h) (by decide)))⟩

theorem splitPrime28Depth64D5D9AllMaskPeriod (x y : ℤ) (h : x%2880=y%2880) : splitPrime28Depth64D5D9AllMaskGood x=splitPrime28Depth64D5D9AllMaskGood y :=
  splitPrime28Depth64D5D9.intGood_congr x y h

