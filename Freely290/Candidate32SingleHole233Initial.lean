theorem candidate32SingleHole233Initial {n : ℕ} (h4 : n%4≠0) (hn : n<candidate32SingleHole233Cost n) :
    Represents candidate32Auxiliary233Matrix.toQuadraticForm' n := by
  by_cases h : n%84=14
  · have hb : n<43286 := lt_of_lt_of_le hn (candidate32Auxiliary233CostBound _)
    let u : Fin 516 := ⟨n/84,by omega⟩
    have e : 84*u.val+14=n := by dsimp [u]; omega
    have hc : 84*u.val+14<candidate32SingleHole233Cost (84*u.val+14) := by simpa only [e] using hn
    refine ⟨candidate32SingleHole233Rare u,?_⟩
    rw [← matrixValue_eq_form]
    simpa only [e] using candidate32SingleHole233RareChecked u hc
  · let u : Fin 221 := ⟨n,lt_of_lt_of_le hn (candidate32SingleHole233OrdinaryBound h)⟩
    exact ⟨candidate32SingleHole233Ordinary u,by rw [← matrixValue_eq_form]; exact candidate32SingleHole233OrdinaryChecked u h4 h hn⟩

