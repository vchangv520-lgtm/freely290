theorem candidate23ClosedTernarySubforms_universal_of_comp (r : Fin 93) {M : Type*} [AddCommGroup M] {Q : QuadraticForm ℤ M}
    (hQ : ∀ x, 0 ≤ Q x) (hc : Checks Q critical) (f : (Fin 4 → ℤ) →ₗ[ℤ] M)
    (hf : Q.comp f = (candidate23FullUpgradeQuadTarget (candidate23ClosedTernarySubformsIndex r)).toQuadraticForm') : Universal Q :=
  (candidate23ClosedTernarySubformsBranch r).universal_of_matrix (candidate23ClosedTernarySubformsEmbedding r) (candidate23ClosedTernarySubformsValid r) hQ hc f hf

