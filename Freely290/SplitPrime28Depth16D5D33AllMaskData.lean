def splitPrime28Depth16D5D33AllMaskGood (z : ℤ) : Bool := splitPrime28Depth16D5D33.intGood z
def splitPrime28Depth16D5D33AllMaskGuard (r : ℕ) : Bool := decide (r%4≠0)
def splitPrime28Depth16D5D33AllMaskDoubled : ℕ := 
def splitPrime28Depth16D5D33AllMaskRequired : ℕ := 

def splitPrime28Depth16D5D33AllMaskTest (j : Fin 5280) : Bool :=
  (splitPrime28Depth16D5D33AllMaskDoubled.testBit j.val == splitPrime28Depth16D5D33AllMaskGood (j.val : ℤ)) &&
  (splitPrime28Depth16D5D33AllMaskRequired.testBit (j.val%2640) == splitPrime28Depth16D5D33AllMaskGuard (j.val%2640))

theorem splitPrime28Depth16D5D33AllMaskGuard_of_squarefree (r : Fin 2640) (hs : Squarefree (Nat.gcd r.val 2640))  :
    splitPrime28Depth16D5D33AllMaskGuard r.val=true := decide_eq_true (fun h ↦ Nat.squarefree_iff_prime_squarefree.mp hs 2 (by decide) (Nat.dvd_gcd (Nat.dvd_of_mod_eq_zero h) (by decide)))

theorem splitPrime28Depth16D5D33AllMaskPeriod (x y : ℤ) (h : x%2640=y%2640) : splitPrime28Depth16D5D33AllMaskGood x=splitPrime28Depth16D5D33AllMaskGood y :=
  splitPrime28Depth16D5D33.intGood_congr x y h

