private theorem candidate22Natural52PackedChecks : ∀ j, (candidate22Natural52PackedBatches j).check candidate22Natural52PackedCoeff candidate22Natural52PackedStep=true := by
  intro j
  fin_cases j
  · exact candidate22Natural52PackedB000_checked

private def candidate22Natural52PackedRow (r : Fin 588) : Prop :=
  BitPlane.rangeCheck 1 588 (candidate22Natural52PackedTail.cost r) r.val (candidate22Natural52PackedStart r)
    (candidate22Natural52PackedBatches (candidate22Natural52PackedWhich r)).edges (candidate22Natural52PackedBatches (candidate22Natural52PackedWhich r)).target=true ∨ ¬Squarefree (Nat.gcd r.val 588)

private instance (r : Fin 588) : Decidable (candidate22Natural52PackedRow r) := by unfold candidate22Natural52PackedRow; infer_instance

private theorem candidate22Natural52PackedRows000 : ∀ t : Fin 128, ∀ h : 0+t.val<588, candidate22Natural52PackedRow ⟨0+t.val,h⟩ := by decide +kernel

private theorem candidate22Natural52PackedRows001 : ∀ t : Fin 128, ∀ h : 128+t.val<588, candidate22Natural52PackedRow ⟨128+t.val,h⟩ := by decide +kernel

private theorem candidate22Natural52PackedRows002 : ∀ t : Fin 128, ∀ h : 256+t.val<588, candidate22Natural52PackedRow ⟨256+t.val,h⟩ := by decide +kernel

private theorem candidate22Natural52PackedRows003 : ∀ t : Fin 128, ∀ h : 384+t.val<588, candidate22Natural52PackedRow ⟨384+t.val,h⟩ := by decide +kernel

private theorem candidate22Natural52PackedRows004 : ∀ t : Fin 128, ∀ h : 512+t.val<588, candidate22Natural52PackedRow ⟨512+t.val,h⟩ := by decide +kernel

private theorem candidate22Natural52PackedCover (r : Fin 588) : candidate22Natural52PackedRow r := by
  let b : Fin 5 := ⟨r.val/128,by omega⟩
  let t : Fin 128 := ⟨r.val%128,Nat.mod_lt _ (by decide)⟩
  have he : 128*b.val+t.val=r.val := by dsimp [b,t];omega
  have allRows : ∀ k : Fin 5, ∀ t : Fin 128, ∀ h : 128*k.val+t.val<588, candidate22Natural52PackedRow ⟨128*k.val+t.val,h⟩ := by
    intro k
    fin_cases k
    · exact candidate22Natural52PackedRows000
    · exact candidate22Natural52PackedRows001
    · exact candidate22Natural52PackedRows002
    · exact candidate22Natural52PackedRows003
    · exact candidate22Natural52PackedRows004
  have good := allRows b t (by rw [he]; exact r.isLt)
  simpa only [he] using good

theorem candidate22Natural52Packed_universal_of_comp {M : Type*} [AddCommGroup M] {Q : QuadraticForm ℤ M}
    (hc : Checks Q critical) (f : (Fin 4 → ℤ) →ₗ[ℤ] M)
    (hf : Q.comp f=candidate22Natural52Matrix.toQuadraticForm') : Universal Q := by
  apply candidate22Natural52PackedTail.universal_of_bitplane_sf_rows_comp candidate22Natural52PackedCoeff (by decide +kernel) candidate22Natural52PackedBatches candidate22Natural52PackedStep
    (by decide) candidate22Natural52PackedChecks candidate22Natural52PackedWhich candidate22Natural52PackedStart candidate22Natural52PackedCover _ hc f hf
  have noEx : ∀ j, (candidate22Natural52PackedBatches j).exceptions=[] := by decide +kernel
  intro j e he
  rw [noEx j] at he
  contradiction

